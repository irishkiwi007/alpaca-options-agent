# Copy this to .env and fill in real values. .env is gitignored — never commit real keys.

ALPACA_API_KEY=your_paper_account_key_id
ALPACA_SECRET_KEY=your_paper_account_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Required for BOTH agent_layer/claude_agent.py (trade review) and
# agent_layer/rules_review_agent.py (strategy self-tuning) — this must be a
# real Anthropic API key from console.anthropic.com, separate from any
# chat interface you used to build this. Without it, both agents fail
# closed (log a clear reason, make no trades / no config changes) rather
# than crashing or trading blind.
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-6
